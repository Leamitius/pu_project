RewriteEngine On


# ==================================================
# 1. PUBLIC Learnset routing
# ==================================================
RewriteRule ^learnsets/([a-zA-Z0-9_-]+)/?$ questions.html?slug=$1 [L,QSA]
RewriteRule ^information/([a-zA-Z0-9_-]+)/?$ infos.html?slug=$1 [L,QSA]


# ==================================================
# 2. Redirect /index or /index.html to /
# ==================================================
RewriteCond %{THE_REQUEST} /index(\.html)? [NC]
RewriteRule ^index(\.html)?$ / [R=301,L]


# ==================================================
# 3. Redirect *.html URLs to no .html
# ==================================================
RewriteCond %{THE_REQUEST} \s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]


# ==================================================
# 4. Map extensionless URLs → .html (KEEP QUERY!)
# ==================================================
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L,QSA]


# ==================================================
# 5. SECURITY
# ==================================================
<Files .env>
    Order allow,deny
    Deny from all
</Files>


<FilesMatch "\.js$">
    Header set Content-Type application/javascript
    Header set X-Content-Type-Options nosniff
</FilesMatch>


RewriteCond %{HTTP_REFERER} !^https://geolearnr\.ch/ [NC]
RewriteRule .*\.js$ - [F]
